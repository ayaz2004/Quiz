// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  isEmailVerified           Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?
  resetPasswordToken        String?
  resetPasswordExpires      DateTime?
  accessToken               String?
  sessionToken              String?
  isAdmin       Int      @default(0)
  profilePhoto  String?
  phoneNumber   String?  @map("phone_number")
  location      String?
  qualification String?
  purchasedExams Json    @default("[]")
  plan          String    @default("free") @db.VarChar(20) // free, pro
  planExpiresAt DateTime? @map("plan_expires_at") // null with plan "pro" = no end date
  createdAt     DateTime @default(now())
  quizAttempts  QuizAttempt[]
  purchases     Purchase[]
  suggestions   Suggestion[]
  userQuestions UserQuestion[]
  adminAnswers  UserQuestion[] @relation("AdminAnswers")
  trackedCourses     TrackedCourse[]
  pushSubscriptions  PushSubscription[]
  resultNotifications ResultNotification[]
  questionResponses  QuestionResponse[]
  reviewItems        ReviewItem[]
  bookmarks          Bookmark[]
  deviceTokens       DeviceToken[]
  dailyActivities    DailyActivity[]
  studyProfile       StudyProfile?
  sessions           Session[]
}

// One row per signed-in device. User.accessToken/sessionToken are still
// written for the most recent sign-in so older server versions keep working.
model Session {
  id           Int      @id @default(autoincrement()) @map("session_id")
  userId       Int      @map("user_id")
  sessionToken String   @unique @map("session_token") @db.Text
  accessToken  String   @map("access_token") @db.Text
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  expiresAt    DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}


model Quiz {
  id          Int       @id @default(autoincrement()) @map("quiz_id")
  title       String    @unique @db.VarChar(100)
  description String
  subject     String    @db.VarChar(100)
  examYear    Int       @map("exam_year")
  educationLevel String @default("undergrad") @map("education_level") @db.VarChar(20) // school, undergrad, masters
  createdBy   Int       @map("created_by")
  isActive    Boolean   @default(true) @map("is_active")
  isPaid      Boolean   @default(false) @map("is_paid")
  price       Float?
  prize       String?
  timeLimit   Int?      @map("time_limit") // Time limit in minutes
  hasNegativeMarking Boolean @default(false) @map("has_negative_marking") // Enable negative marking
  negativeMarks      Float?  @map("negative_marks") // Negative marks per wrong answer (e.g., 0.25, 0.5, 1)
  createdAt   DateTime  @default(now()) @map("created_at")
  questions   Question[]
  cutoffs     QuizCutoff[]
  quizAttempts QuizAttempt[]
  suggestions Suggestion[]
  purchases   Purchase[]
}

model QuizCutoff {
  id             Int      @id @default(autoincrement()) @map("cutoff_id")
  quizId         Int      @map("quiz_id")
  year           Int
  general        Float?
  muslim         Float?
  muslimObcSt    Float?   @map("muslim_obc_st")
  muslimWomen    Float?   @map("muslim_women")
  jk             Float?
  km             Float?
  pwd            Float?
  pwdLocomoter   Float?   @map("pwd_locomoter")
  pwdBlindVision Float?   @map("pwd_blind_vision")
  pwdHearing     Float?   @map("pwd_hearing")
  jamiaInternal  Float?   @map("jamia_internal")
  createdAt      DateTime @default(now()) @map("created_at")

  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, year])
  @@index([quizId])
  @@index([year])
  @@map("quiz_cutoffs")
}

model Question {
  id           Int    @id @default(autoincrement()) @map("question_id")
  quizId       Int    @map("quiz_id")
  questionOrder Int   @default(0) @map("question_order")
  questionText String @map("question_text")
  option1      String
  option2      String
  option3      String
  option4      String
  isCorrect    Int    @map("is_correct")
  explanation  String?
  imageUrl     String? @map("image_url")
  topicId              Int?    @map("topic_id") // Approved topic
  suggestedTopicId     Int?    @map("suggested_topic_id") // Unreviewed suggestion, never exposed to users
  suggestionConfidence Float?  @map("suggestion_confidence")
  difficulty           String? @db.VarChar(10) // easy, medium, hard
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic          Topic? @relation("QuestionTopic", fields: [topicId], references: [id], onDelete: SetNull)
  suggestedTopic Topic? @relation("QuestionSuggestedTopic", fields: [suggestedTopicId], references: [id], onDelete: SetNull)
  responses    QuestionResponse[]
  reviewItems  ReviewItem[]
  bookmarks    Bookmark[]

  @@index([topicId])
}

model Topic {
  id        Int      @id @default(autoincrement()) @map("topic_id")
  subject   String   @db.VarChar(100)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  questions          Question[] @relation("QuestionTopic")
  suggestedQuestions Question[] @relation("QuestionSuggestedTopic")

  @@unique([subject, name])
  @@map("topics")
}

model QuestionResponse {
  id             Int      @id @default(autoincrement()) @map("response_id")
  userId         Int      @map("user_id")
  questionId     Int      @map("question_id")
  selectedOption Int      @map("selected_option")
  isCorrect      Boolean  @map("is_correct")
  timeTakenMs    Int      @default(0) @map("time_taken_ms")
  source         String   @db.VarChar(20) // practice, review, today, exam
  clientId       String   @map("client_id") @db.VarChar(80)
  answeredAt     DateTime @map("answered_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, questionId, answeredAt])
  @@index([userId, answeredAt])
  @@map("question_responses")
}

// Derived spaced-repetition state, recomputed from QuestionResponse history
model ReviewItem {
  id             Int      @id @default(autoincrement()) @map("review_item_id")
  userId         Int      @map("user_id")
  questionId     Int      @map("question_id")
  box            Int
  dueAt          DateTime @map("due_at")
  lastAnsweredAt DateTime @map("last_answered_at")
  wrongCount     Int      @map("wrong_count")
  graduated      Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, graduated, dueAt])
  @@map("review_items")
}

model Bookmark {
  id         Int      @id @default(autoincrement()) @map("bookmark_id")
  userId     Int      @map("user_id")
  questionId Int      @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("bookmarks")
}

model DeviceToken {
  id        Int      @id @default(autoincrement()) @map("device_token_id")
  userId    Int      @map("user_id")
  token     String   @unique @db.Text
  platform  String   @db.VarChar(10) // android, ios, web
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model DailyActivity {
  id                Int      @id @default(autoincrement()) @map("daily_activity_id")
  userId            Int      @map("user_id")
  date              DateTime @db.Date // Calendar day in Asia/Kolkata
  questionsAnswered Int      @default(0) @map("questions_answered")
  correctCount      Int      @default(0) @map("correct_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_activities")
}

model StudyProfile {
  id               Int       @id @default(autoincrement()) @map("study_profile_id")
  userId           Int       @unique @map("user_id")
  targetCourseKey  String?   @map("target_course_key") @db.VarChar(120)
  targetCourseName String?   @map("target_course_name") @db.VarChar(255)
  category         String?   @db.VarChar(30)
  dailyGoal        Int       @default(15) @map("daily_goal")
  examDate         DateTime? @map("exam_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_profiles")
}

// Free-plan allowance per feature (keys in services/entitlements.js), set from
// the admin panel. No row or a null limit means unlimited. With enforced=false
// the limit is only used to measure how many users would reach it.
model FeatureLimit {
  key       String   @id @db.VarChar(50)
  freeLimit Int?     @map("free_limit")
  enforced  Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_limits")
}

// Running costs (INR) entered by an admin, per calendar month.
model MonthlyCost {
  id        Int      @id @default(autoincrement()) @map("monthly_cost_id")
  month     DateTime @db.Date // First day of the month
  item      String   @db.VarChar(100)
  amount    Float
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([month, item])
  @@map("monthly_costs")
}

model QuizAttempt {
  id             Int      @id @default(autoincrement()) @map("attempt_id")
  userId         Int      @map("user_id")
  quizId         Int      @map("quiz_id")
  score          Float
  totalQuestions Int      @map("total_questions")
  correctAnswers Int      @map("correct_answers")
  wrongAnswers   Int      @map("wrong_answers")
  percentage     Float
  timeTaken      Int?     @map("time_taken")
  answers        Json
  attemptedAt    DateTime @default(now()) @map("attempted_at")
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([quizId])
  @@index([attemptedAt])
  @@map("quiz_attempts")
}

model Purchase {
  id          Int      @id @default(autoincrement()) @map("purchase_id")
  userId      Int      @map("user_id")
  quizId      Int      @map("quiz_id")
  amount      Float
  status      String   @default("completed") @db.VarChar(20)
  purchasedAt DateTime @default(now()) @map("purchased_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
  @@index([purchasedAt])
  @@map("purchases")
}

model Suggestion {
  id          Int      @id @default(autoincrement()) @map("suggestion_id")
  userId      Int      @map("user_id")
  quizId      Int      @map("quiz_id")
  attemptId   Int?     @map("attempt_id")
  suggestionText String  @map("suggestion_text") @db.Text
  status      String   @default("pending") @db.VarChar(20) // pending, reviewed, resolved
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([quizId])
  @@index([status])
  @@index([createdAt])
  @@map("suggestions")
}

model UserQuestion {
  id          Int      @id @default(autoincrement()) @map("question_id")
  userId      Int?     @map("user_id")
  guestEmail  String?  @map("guest_email")
  question    String   @db.Text
  category    String   @db.VarChar(20) // JMI, AMU, or general
  answer      String?  @db.Text
  answeredBy  Int?     @map("answered_by")
  answeredAt  DateTime? @map("answered_at")
  status      String   @default("pending") @db.VarChar(20) // pending, answered
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       User?    @relation("AdminAnswers", fields: [answeredBy], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([guestEmail])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("user_questions")
}

model TrackedCourse {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  courseTypeId     String   @map("course_type_id") @db.VarChar(100)
  courseTypeName   String   @map("course_type_name") @db.VarChar(255)
  courseNameId     String   @map("course_name_id") @db.VarChar(100)
  courseName       String   @map("course_name") @db.VarChar(500)
  phdDisciplineId  String   @default("") @map("phd_discipline_id") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseTypeId, courseNameId, phdDisciplineId], map: "tracked_course_user_key")
  @@index([courseTypeId, courseNameId, phdDisciplineId], map: "tracked_course_lookup_idx")
  @@index([userId], map: "tracked_course_user_idx")
  @@map("tracked_courses")
}

model CourseResultSnapshot {
  id              Int       @id @default(autoincrement())
  courseTypeId    String    @map("course_type_id") @db.VarChar(100)
  courseNameId    String    @map("course_name_id") @db.VarChar(100)
  phdDisciplineId String    @default("") @map("phd_discipline_id") @db.VarChar(100)
  courseTypeName  String?   @map("course_type_name") @db.VarChar(255)
  courseName      String?   @map("course_name") @db.VarChar(500)
  fingerprint     String    @db.VarChar(64)
  resultsJson     Json      @map("results_json")
  lastCheckedAt   DateTime  @default(now()) @map("last_checked_at")
  lastChangedAt   DateTime? @map("last_changed_at")

  @@unique([courseTypeId, courseNameId, phdDisciplineId], map: "crs_snapshot_course_key")
  @@index([courseTypeId, courseNameId, phdDisciplineId], map: "crs_snapshot_course_idx")
  @@map("course_result_snapshots")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model ResultNotification {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  courseTypeId    String    @map("course_type_id") @db.VarChar(100)
  courseNameId    String    @map("course_name_id") @db.VarChar(100)
  phdDisciplineId String    @default("") @map("phd_discipline_id") @db.VarChar(100)
  courseTypeName  String    @map("course_type_name") @db.VarChar(255)
  courseName      String    @map("course_name") @db.VarChar(500)
  title           String    @db.VarChar(255)
  body            String    @db.Text
  resultLink      String?   @map("result_link") @db.Text
  fingerprint     String    @db.VarChar(64)
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("result_notifications")
} 

enum ScholarshipStatus {
  PUBLISHED
  UNPUBLISHED
}

model ScholarshipCategory {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scholarship_categories")
}

model Scholarship {
  id            Int       @id @default(autoincrement()) @map("scholarship_id")
  slug          String    @unique @db.VarChar(150)
  title         String    @db.VarChar(255)
  provider      String    @db.VarChar(255)
  description   String?   @db.Text
  about         String?   @db.Text
  categories    String[]  @default([])
  amount        String?   @db.VarChar(255)
  startDate     DateTime? @map("start_date")
  deadline      DateTime? @map("deadline")
  applyUrl      String?   @map("apply_url") @db.Text
  eligibility   Json?     @map("eligibility")
  documents     Json?     @map("documents")
  steps         Json?     @map("steps")
  importantInfo String?   @map("important_info") @db.Text
  featured      Boolean   @default(false)
  status        ScholarshipStatus @default(UNPUBLISHED)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("scholarships")
}