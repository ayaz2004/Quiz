# Copy to .env and fill in. Names only: never commit real values.

# --- Server ---
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database (config/db.config.js) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Used by the Prisma CLI (migrate, studio) and scripts
DATABASE_URL=

# --- Auth ---
# Signs both the access token (24h) and the session token (7d)
JWT_SECRET=

# --- Email (Brevo) ---
EMAIL_USER=
BREVO_API_KEY=

# --- Question images (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web push (result tracking on the website) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Phone push (FCM): set ONE of these. Without either, phone push is off ---
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Background jobs ---
# Required by POST /api/result-track/poll (x-cron-secret header)
CRON_SECRET=
# Optional cron expressions overriding the defaults
RESULT_POLL_CRON=
SCHOLARSHIP_EXPIRY_CRON=

# --- Scripts only (data copy between databases) ---
SOURCE_DATABASE_URL=
